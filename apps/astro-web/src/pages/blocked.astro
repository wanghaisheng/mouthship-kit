---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Access Blocked - Mouthship Kit">
  <main class="container mx-auto p-6 text-center">
    <div class="max-w-md mx-auto">
      <div class="text-orange-600 mb-4">
        <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L5.636 5.636"/>
        </svg>
      </div>
      
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Access Blocked
      </h1>
      
      <p class="text-gray-600 mb-6">
        Your access has been temporarily blocked due to too many requests.
      </p>
      
      <div class="bg-orange-50 border border-orange-200 p-4 rounded-lg mb-6">
        <h2 class="font-semibold text-orange-800 mb-2">Rate Limit Exceeded</h2>
        <p class="text-orange-700 text-sm">
          You have made too many requests in a short period. 
          This is a security measure to protect our services.
        </p>
      </div>
      
      <div class="bg-blue-50 p-4 rounded-lg mb-6">
        <h2 class="font-semibold mb-2">What can you do?</h2>
        <ul class="text-sm text-gray-600 space-y-2">
          <li>• Wait a few minutes before trying again</li>
          <li>• Avoid making rapid successive requests</li>
          <li>• Check if you're using automated scripts</li>
          <li>• Contact support if you believe this is an error</li>
        </ul>
      </div>
      
      <div class="space-y-4">
        <div class="text-sm text-gray-500">
          <p>This block will automatically expire after a short period.</p>
          <p>If you continue to experience issues, please contact our support team.</p>
        </div>
        
        <div class="pt-4">
          <a 
            href="/" 
            class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
          >
            Return to Home
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 500px;
  }
</style>
