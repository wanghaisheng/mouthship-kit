---
import Layout from '../../layouts/Layout.astro'
// Note: This import will be available once dependencies are installed
// import { createGoogleAuthorizationURL } from '@mouthshipkit/auth/providers/google'

// Mock Google auth URL - will be replaced with real implementation
const googleAuthUrl = 'https://accounts.google.com/o/oauth2/v2/auth?client_id=mock_client_id'

// For now, redirect to Google OAuth
// In real implementation: const googleAuthUrl = await createGoogleAuthorizationURL()
---

<Layout title="Google Login - Mouthship Kit">
  <main class="container mx-auto p-6 text-center">
    <div class="max-w-md mx-auto">
      <h1 class="text-2xl font-bold mb-6">Signing in with Google</h1>
      
      <div class="bg-blue-50 p-6 rounded-lg">
        <p class="mb-4 text-gray-600">
          You will be redirected to Google to authorize this application.
        </p>
        
        <a 
          href={googleAuthUrl}
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-4.81 1.06-4.81z"/>
            <path fill="#FBBC05" d="M3.85 15.43c-.39-1.16-.39-2.41 0-3.57L12 3.67v4.26c2.97 0 5.46-.98 7.28-2.66z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.57-2.77C17.45 2.09 14.97 1 12 1 7.75 1 3.85 3.85 3.85 8.63v2.77l3.85-3.02z"/>
          </svg>
          Continue with Google
        </a>
      </div>
      
      <div class="mt-6">
        <a href="/login" class="text-blue-600 hover:text-blue-800 underline">
          ← Back to Login Options
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 500px;
  }
</style>
