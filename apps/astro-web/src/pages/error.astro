---
import Layout from '../layouts/Layout.astro'

export interface Props {
  code?: number;
  message?: string;
}

const { code = 500, message = 'An unexpected error occurred' } = Astro.props;

// Log error to console (in production, this would be Sentry)
console.error('Global error:', { code, message, url: Astro.url.href });
---

<Layout title={`Error ${code} - Mouthship Kit`}>
  <main class="container mx-auto p-6 text-center">
    <div class="max-w-lg mx-auto">
      <div class="text-red-600 mb-4">
        <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
      </div>
      
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Error {code}
      </h1>
      
      <p class="text-gray-600 mb-6">
        {message}
      </p>
      
      <div class="space-y-4">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h2 class="font-semibold mb-2">What happened?</h2>
          <p class="text-sm text-gray-600">
            An unexpected error occurred while processing your request. 
            Our team has been notified and is working on a fix.
          </p>
        </div>
        
        <div class="bg-blue-50 p-4 rounded-lg">
          <h2 class="font-semibold mb-2">What can you do?</h2>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>• Try refreshing the page</li>
            <li>• Check your internet connection</li>
            <li>• Go back to the previous page</li>
            <li>• Contact support if the problem persists</li>
          </ul>
        </div>
      </div>
      
      <div class="mt-8 space-x-4">
        <a 
          href="/" 
          class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
        >
          Go Home
        </a>
        <button 
          onclick="history.back()" 
          class="px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
        >
          Go Back
        </button>
      </div>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 600px;
  }
</style>
