{
  "name": "@mouthshipkit/auth",
  "version": "0.4.3",
  "private": true,
  "description": "Auth package for mouthshipkit",
  "license": "MIT",
  "author": "mouthshipkit",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/github": {
      "types": "./dist/providers/github.d.ts",
      "default": "./dist/providers/github.js"
    },
    "./providers/google": {
      "types": "./dist/providers/google.d.ts",
      "default": "./dist/providers/google.js"
    },
    "./actions/logout": {
      "types": "./dist/actions/logout.d.ts",
      "default": "./dist/actions/logout.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "bun run rm -rf dist *.tsbuildinfo",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint .  --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@lucia-auth/adapter-drizzle": "^1.0.0",
    "arctic": "^1.9.2",
    "lucia": "^3.2.2",
    "next": "14.2.35",
    "oslo": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "@mouthshipkit/db": "workspace:^",
    "@mouthshipkit/env": "workspace:^",
    "@mouthshipkit/utils": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@mouthshipkit/eslint": "workspace:^",
    "@mouthshipkit/tsconfig": "workspace:^"
  }
}